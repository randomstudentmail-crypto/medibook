# ============================================================
#  MediBook — Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# Session secret (use a long random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# Database path (SQLite file)
DB_PATH=./db/medibook.sqlite

# ============================================================
#  Email Configuration (Nodemailer)
# ============================================================
# For Gmail: enable "App Passwords" in Google Account settings
#   Go to: myaccount.google.com → Security → App Passwords
#   Generate a password for "Mail" and paste it below

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM=MediBook <your-email@gmail.com>

# For Outlook/Office365:
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# For custom SMTP (e.g. SendGrid):
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key

# Hospital info shown in emails
HOSPITAL_NAME=MediBook General Hospital
HOSPITAL_PHONE=1-800-MEDIBOOK
HOSPITAL_ADDRESS=123 Health Avenue, Medical City, MC 10001
HOSPITAL_WEBSITE=https://yourdomain.com
